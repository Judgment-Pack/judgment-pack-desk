{
  "version": 1,
  "toolchains": {"node": {"version": "22"}, "go": {"version": "1.26.5"}, "python": {"version": "3.12", "venv": ".venv"}},
  "setup": [
    {"name": "npm-ci", "run": "npm ci", "cwd": "web", "toolchain": "node", "timeout": 900}
  ],
  "checks": [
    {"name": "diff-check", "run": "git diff --check", "toolchain": "shell"},
    {"name": "local-paths", "run": "if git grep -noEI '(^|[^A-Za-z0-9_])/(home|Users)/[A-Za-z0-9_.-]+' | grep -vE '/(home|Users)/(someone|owner|secret|alone|x|y)$'; then echo 'a machine-local path is in tracked text'; exit 1; fi", "toolchain": "shell"},
    {"name": "agent-docs", "run": "scripts/sync-agent-docs.sh --check .", "toolchain": "shell", "summary": "^sync-agent-docs:"},
    {"name": "component-policy", "run": "python3 scripts/component-releases.py check", "toolchain": "python", "timeout": 300},
    {"name": "gofmt", "run": "unformatted=$(gofmt -l $(git ls-files '*.go')); if [ -n \"$unformatted\" ]; then echo 'not gofmt-formatted:'; echo \"$unformatted\"; exit 1; fi", "toolchain": "go"},
    {"name": "python-tests", "run": "for t in scripts/component-releases_test.py scripts/dev-components_test.py scripts/dev/gateway-fixture_test.py scripts/desk-dev_test.py scripts/desk-update_test.py scripts/package-release_test.py scripts/published-components_test.py scripts/assemble-release_test.py scripts/build-bundle_test.py scripts/needle-check_test.py scripts/mutation-check_test.py scripts/mutation-nightly-table_test.py scripts/mutation-rows-changed_test.py; do python3 \"$t\" || exit 1; done", "toolchain": "python", "summary": "^(Ran |FAILED)", "timeout": 900},
    {"name": "needle-check", "run": "scripts/needle-check.sh .", "toolchain": "shell", "timeout": 600},
    {"name": "i18n-check", "run": "npm run i18n:check", "cwd": "web", "toolchain": "node", "timeout": 300},
    {"name": "ui-message-audit", "run": "node --test scripts/ui-message-audit.test.mjs", "cwd": "web", "toolchain": "node", "summary": "^# (pass|fail) ", "timeout": 300},
    {"name": "typecheck", "run": "npm run typecheck", "cwd": "web", "toolchain": "node", "timeout": 900},
    {"name": "component-identities", "run": "python3 scripts/component-releases.py verify", "toolchain": "python", "summary": " verified$", "timeout": 900},
    {"name": "go-vet", "run": "go vet ./...", "toolchain": "go", "timeout": 3000},
    {"name": "vite-build", "run": "npx vite build", "cwd": "web", "toolchain": "node", "timeout": 900},
    {"name": "web-tests", "run": "npm test", "cwd": "web", "toolchain": "node", "summary": "^\\s*(Test Files|Tests)\\s", "timeout": 1800},
    {"name": "dialect-read", "run": "scripts/dev/web-fixtures.sh dialect-read", "toolchain": "node", "summary": "^dialect-read:", "timeout": 900},
    {"name": "go-test", "run": "go test -v ./...", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "harness-vectors", "run": "scripts/dev/web-fixtures.sh harness-vectors", "toolchain": "node", "summary": "^harness-vectors:", "timeout": 600},
    {"name": "certify-vercel", "run": "scripts/dev/web-fixtures.sh certify vercel", "toolchain": "node", "summary": "^certify-harness [a-z]+: (passed|failed)", "timeout": 1200},
    {"name": "certify-codex", "run": "scripts/dev/web-fixtures.sh certify codex", "toolchain": "node", "summary": "^certify-harness [a-z]+: (passed|failed)", "timeout": 1200},
    {"name": "certify-deepagents", "run": "scripts/dev/web-fixtures.sh certify deepagents", "toolchain": "node", "summary": "^certify-harness [a-z]+: (passed|failed)", "timeout": 1200},
    {"name": "local-gateway", "run": "scripts/dev/local-gateway.sh", "toolchain": "go", "timeout": 1500},
    {"name": "official-companions", "run": "scripts/dev/jobs-companion.sh install", "toolchain": "python", "timeout": 900},
    {"name": "jobs-runtime", "run": "scripts/dev/jobs-companion.sh runtime-jobs", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "jobs-run-signer", "run": "scripts/dev/jobs-companion.sh run-signer", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "jobs-executor-ownership", "run": "scripts/dev/jobs-companion.sh executor-ownership", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "policy-official-draft", "run": "scripts/dev/jobs-companion.sh policy-draft", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "policy-manual-admission", "run": "scripts/dev/jobs-companion.sh policy-manual-admission", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "witness", "run": "scripts/dev/jobs-companion.sh witness", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "new-desks-runtime", "run": "scripts/dev/jobs-companion.sh new-desks", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "exchange-presets", "run": "scripts/dev/jobs-companion.sh exchange-presets", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "dialect-journeys", "run": "scripts/dev/jobs-companion.sh dialect-journeys", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "assistant-saved-context", "run": "scripts/dev/jobs-companion.sh saved-context", "toolchain": "go", "summary": "^(ok|FAIL|Browser reference verification:)", "timeout": 900},
    {"name": "signed-exchange-release", "run": "scripts/dev/jobs-companion.sh signed-exchange-release", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "acquisition-fixture", "run": "scripts/dev/jobs-companion.sh acquisition-fixture", "toolchain": "go", "timeout": 3000},
    {"name": "acquisition-acceptance", "run": "scripts/dev/jobs-companion.sh acquisition-acceptance", "toolchain": "go", "summary": "^(ok|FAIL) ", "timeout": 3000},
    {"name": "policy-source-contract", "run": "scripts/dev/policy-source-contract.sh", "toolchain": "go", "summary": "^(--- PASS|FAIL|observation\\.json: )", "timeout": 1500},
    {"name": "development-build", "run": "scripts/dev/development-build.sh", "toolchain": "go", "summary": "^development-build:", "timeout": 1500},
    {"name": "component-freshness", "run": "python3 scripts/component-releases.py status", "toolchain": "python", "timeout": 300, "requires_env": "DESK_CHECK_FRESHNESS", "optional": true},
    {"name": "mutation-rows", "run": "scripts/dev/mutation-rows.sh", "toolchain": "go", "summary": "^(mutation-rows:|discriminating:)", "timeout": 13800, "requires_env": "DESK_MUTATION_BASE", "optional": true}
  ]
}
