{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "desk: start",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Build companions from the component lock if needed, then build and start Desk + Vite; keep the saved project. Safe to run again.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: stop",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Stop only the development servers started by these tasks; preserve workspace files.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: prune",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "prune"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "With Desk stopped, remove old launch directories under bin/dev-launches, keeping the one the last start used. Refuses while these servers run.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: restart",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "restart"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Rebuild Desk (and companions if the lock changed), then restart both servers. A build failure leaves the current session running.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: status",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Show development server status and the log directory.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: dev",
      "detail": "Start Desk + Vite (alias for desk: start).",
      "dependsOn": [
        "desk: start"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "desk: open (hot reload)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "start",
        "--open"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Start Desk if needed, wait until ready, and open the browser.",
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
