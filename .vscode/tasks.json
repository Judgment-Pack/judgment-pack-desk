{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "desk: start",
      "type": "process",
      "command": "${env:HOME}/.local/bin/jpack-desk",
      "args": [
        "--port",
        "5173"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Start the installed Desk at http://localhost:5173/ using its saved startup Desk. Use Tasks: Terminate Task or Tasks: Restart Running Task to stop or restart.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "desk: dev start",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Manage the development checkout with its pinned companions. The installed Desk uses desk: start.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: dev stop",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Manage the development checkout with its pinned companions. The installed Desk uses desk: start.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: dev restart",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "restart"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Manage the development checkout with its pinned companions. The installed Desk uses desk: start.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "desk: dev prune",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/desk-dev.py",
        "prune"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Manage the development checkout with its pinned companions. The installed Desk uses desk: start.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
