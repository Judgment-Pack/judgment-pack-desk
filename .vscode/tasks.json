{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "desk: start",
      "type": "process",
      "command": "${env:HOME}/.local/bin/jpack-desk",
      "args": [
        "--port",
        "5173"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Start the installed Desk at http://localhost:5173/ using its saved startup Desk. Use Tasks: Terminate Task or Tasks: Restart Running Task to stop or restart.",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
